{
  "manifest_version": 3,
  "name": "stz downloader integration",
  "version": "0.1.0",
  "description": "Intercepta downloads do navegador e envia para o stz-downloader (aria2).",
  "permissions": ["downloads", "cookies", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "stz downloader",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
